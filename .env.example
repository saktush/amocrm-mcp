# Required
AMO_SUBDOMAIN=your-subdomain

# Auth, choose one:
#  A) Recommended: OAuth integration. Set the ID, secret and redirect URI, then run
#     `amocrm-mcp-auth --code <authorization code>` once (see README, "Getting the first token pair").
#     It writes the access/refresh tokens to AMO_TOKEN_FILE and the server refreshes them automatically.
#  B) Long-lived token only (no auto-refresh): set AMO_ACCESS_TOKEN.
AMO_CLIENT_ID=your-client-id
AMO_CLIENT_SECRET=your-client-secret
# OAuth redirect URI; must match the integration settings exactly
AMO_REDIRECT_URI=https://localhost
# AMO_ACCESS_TOKEN=your-access-token
# Only if you already have a refresh token (otherwise amocrm-mcp-auth creates it):
# AMO_REFRESH_TOKEN=your-refresh-token

# Optional
# Where tokens are persisted (takes precedence over AMO_ACCESS_TOKEN/AMO_REFRESH_TOKEN).
# Use a different file per account/environment. Gitignored as .amo_tokens*.json
# AMO_TOKEN_FILE=.amo_tokens.json
# Platform domain for API and OAuth: amocrm.ru (default), amocrm.com or kommo.com
AMO_BASE_DOMAIN=amocrm.ru
# Max items per batch_* call (default 50, hard cap 250)
AMO_MAX_BATCH_SIZE=50
AMO_TRANSPORT=stdio
AMO_PORT=8000
